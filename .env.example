# Lokal utvikling. Kopier til .env i rot og apps/web/.env.local
DATABASE_URL=postgresql://straume:straume@localhost:5432/straume
AUTH_SECRET=dev-only-not-a-secret-change-in-prod-32b
SEED_PASSWORD=bytt-meg-lokalt
NEXT_PUBLIC_SHOW_DEMO_LOGIN=1

# Tom S3_ENDPOINT lagrer filer på disk i DATA_DIR. Sett endepunkt for Garage, SeaweedFS, RustFS eller annen S3-tjeneste.
S3_ENDPOINT=
S3_REGION=eu-north-1
S3_BUCKET=straume
S3_ACCESS_KEY=straume
S3_SECRET_KEY=straume-dev-secret
DATA_DIR=./.data

WINNER_EMAIL=tegner@example.com

# Tom nøkkel gir deterministisk tilbudsutkast uten kall til Claude.
# Med nøkkel kalles Claude. Feil vises som «AI-utkast feilet: …» og faller ikke tilbake til mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_INPUT_USD_PER_MTOK=3
ANTHROPIC_OUTPUT_USD_PER_MTOK=15
MAIL_PROVIDER=log
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
