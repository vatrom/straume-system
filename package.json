{
  "name": "straume",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @straume/web dev",
    "build": "pnpm --filter @straume/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @straume/db generate",
    "db:migrate": "pnpm --filter @straume/db migrate",
    "db:seed": "pnpm --filter @straume/db seed",
    "db:reset": "pnpm --filter @straume/db reset"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "unrs-resolver"]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.9.3"
  }
}
