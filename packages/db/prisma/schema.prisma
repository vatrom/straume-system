generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  selger
  prosjektleder
  kontor
}

enum DealStatus {
  open
  won
  lost
}

enum ProjectStatus {
  open
  completed
  cancelled
}

enum ChangeOrderStatus {
  draft
  sent
  approved
  rejected
}

enum DocumentVisibility {
  internal
  customer
  craftsman
}

enum MediaKind {
  photo
  video
  voice
  text
}

enum QuestionType {
  yes_no
  number
  measurement
  choice
  text
  text_short
  multi
  date
  media
}

enum PriceListStatus {
  draft
  active
  archived
}

enum PriceItemType {
  unit_price
  hours
  callout
  package
  freetext
  percent_addon
}

enum ActivityType {
  call
  meeting
  task
  deadline
  email
  lunch
}

enum QuoteStatus {
  draft
  pending_approval
  internally_approved
  approved
  sent
  signed
  accepted
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedDeals      Deal[]         @relation("DealOwner")
  ownedOrgs       Organization[] @relation("OrgOwner")
  ownedPeople     Person[]       @relation("PersonOwner")
  sellerProjects  Project[]      @relation("Seller")
  managedProjects Project[]      @relation("ProjectManager")
  activities      Activity[]
  documents       Document[]
  auditLogs       AuditLog[]
  inspections     Inspection[]
  salesGoals      SalesGoal[]       @relation("GoalOwner")
  savedReports    SavedReport[]     @relation("ReportOwner")
  dashboards      InsightDashboard[] @relation("DashboardOwner")
  approvedQuotes  Quote[]            @relation("QuoteApprover")
}

model OptionList {
  id    String       @id
  key   String       @unique
  name  String
  items OptionItem[]
}

model OptionItem {
  id        String     @id @default(uuid())
  listId    String
  list      OptionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int
  active    Boolean    @default(true)

  @@unique([listId, label])
  @@index([listId, sortOrder])
}

model Pipeline {
  id                     String  @id @default(uuid())
  name                   String
  sortOrder              Int
  dealProbabilityEnabled Boolean @default(false)
  stages                 Stage[]
  deals                  Deal[]
}

model Stage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int
  probability Int
  rottenDays  Int?
  deals       Deal[]

  @@index([pipelineId, sortOrder])
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  orgNumber String?
  address   String?
  ownerId   String?
  owner     User?     @relation("OrgOwner", fields: [ownerId], references: [id])
  label     String?
  people    Person[]
  deals     Deal[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Person {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  ownerId        String?
  owner          User?         @relation("PersonOwner", fields: [ownerId], references: [id])
  label          String?
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  municipality   String?
  country        String?       @default("Norge")
  deals          Deal[]
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Deal {
  id                  String     @id @default(uuid())
  title               String
  valueNok            Decimal    @default(0) @db.Decimal(12, 2)
  ownerId             String
  owner               User       @relation("DealOwner", fields: [ownerId], references: [id])
  personId            String?
  person              Person?    @relation(fields: [personId], references: [id])
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  pipelineId          String
  pipeline            Pipeline   @relation(fields: [pipelineId], references: [id])
  stageId             String
  stage               Stage      @relation(fields: [stageId], references: [id])
  status              DealStatus @default(open)
  sourceChannel       String?
  expectedCloseDate   DateTime?  @db.Date
  plannedStartDate    DateTime?  @db.Date
  lostReason          String?
  lostComment         String?
  probabilityOverride Int?
  label               String?
  postalCode          String?
  area                String?
  stageEnteredAt      DateTime   @default(now())
  wonAt               DateTime?
  lostAt              DateTime?
  project             Project?
  stageEvents         DealStageEvent[]
  valueEvents         DealValueEvent[]
  fieldValues         DealFieldValue[]
  documents           Document[]
  inspections         Inspection[]
  floors              Floor[]
  media               Media[]
  notes               Note[]
  activities          Activity[]
  quotes              Quote[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([pipelineId, status])
  @@index([stageId])
  @@index([ownerId])
  @@index([wonAt])
  @@index([lostAt])
  @@index([createdAt])
  @@index([area])
}

model Activity {
  id        String       @id @default(uuid())
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ActivityType
  subject   String
  note      String?
  dueAt     DateTime?
  done      Boolean      @default(false)
  doneAt    DateTime?
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id])
  internal  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ProjectBoard {
  id        String         @id @default(uuid())
  name      String
  sortOrder Int
  phases    ProjectPhase[]
  projects  Project[]
}

model ProjectPhase {
  id        String       @id @default(uuid())
  boardId   String
  board     ProjectBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int
  rottenDays Int?
  projects   Project[]

  @@index([boardId, sortOrder])
}

model Project {
  id               String        @id @default(uuid())
  title            String
  dealId           String?       @unique
  deal             Deal?         @relation(fields: [dealId], references: [id])
  personId         String?
  person           Person?       @relation(fields: [personId], references: [id])
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  boardId          String
  board            ProjectBoard  @relation(fields: [boardId], references: [id])
  phaseId          String
  phase            ProjectPhase  @relation(fields: [phaseId], references: [id])
  status           ProjectStatus @default(open)
  sellerId         String
  seller           User          @relation("Seller", fields: [sellerId], references: [id])
  projectManagerId String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  street           String?
  houseNumber      String?
  postalCode       String?
  city             String?
  municipality     String?
  contractSumNok   Decimal?      @db.Decimal(12, 2)
  startDate        DateTime?     @db.Date
  endDate          DateTime?     @db.Date
  plannedStartDate DateTime?     @db.Date
  plannedEndDate   DateTime?     @db.Date
  phaseEnteredAt   DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  changes          ChangeOrder[]
  documents        Document[]
  inspections      Inspection[]
  floors           Floor[]
  media            Media[]
  notes            Note[]
  activities       Activity[]
  quotes           Quote[]

  @@index([sellerId])
  @@index([projectManagerId])
  @@index([phaseId])
  @@index([status])
}

model ChangeOrder {
  id           String            @id @default(uuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  amountNok    Decimal?          @db.Decimal(12, 2)
  status       ChangeOrderStatus @default(draft)
  internalNote String?
  priceListId  String?
  customerText String?           @db.Text
  assumptions  String?           @db.Text
  sumExVat     Decimal?          @db.Decimal(12, 2)
  totalIncVat  Decimal?          @db.Decimal(12, 2)
  marginExVat  Decimal?          @db.Decimal(8, 5)
  hoursTotal   Decimal?          @db.Decimal(10, 2)
  approvedById String?
  approvedAt   DateTime?
  portalStatus String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lines        ChangeOrderLine[]
}

model Document {
  id           String             @id @default(uuid())
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  name         String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  visibility   DocumentVisibility @default(internal)
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([dealId])
}

model Inspection {
  id                String                    @id
  projectId         String?
  project           Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId            String?
  deal              Deal?                     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  inspectorId       String?
  inspector         User?                     @relation(fields: [inspectorId], references: [id])
  templateVersionId String?
  templateVersion   ChecklistTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  status            String                    @default("draft")
  visitedAt         DateTime?
  fieldUpdatedAt    Json                      @default("{}")
  updatedAt         DateTime
  createdAt         DateTime                  @default(now())
  deletedAt         DateTime?
  floors            Floor[]
  answers           ChecklistAnswer[]
  media             Media[]
  notes             Note[]

  @@index([projectId])
  @@index([dealId])
  @@index([updatedAt])
}

model Floor {
  id             String      @id
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  inspectionId   String?
  inspection     Inspection? @relation(fields: [inspectionId], references: [id])
  name           String
  sortOrder      Int
  fieldUpdatedAt Json        @default("{}")
  updatedAt      DateTime
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  rooms          Room[]
  media          Media[]
  notes          Note[]

  @@index([projectId])
  @@index([dealId])
  @@index([updatedAt])
}

model Room {
  id                String    @id
  floorId           String
  floor             Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name              String
  sortOrder         Int
  perimeterM        Decimal?  @db.Decimal(10, 3)
  ceilingHeightM    Decimal?  @db.Decimal(10, 3)
  floorAreaM        Decimal?  @db.Decimal(10, 3)
  measurementSource String    @default("manual")
  sketch            Json?
  fieldUpdatedAt    Json      @default("{}")
  updatedAt         DateTime
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?
  walls             Wall[]
  media             Media[]
  notes             Note[]

  @@index([floorId])
  @@index([updatedAt])
}

model Wall {
  id             String    @id
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  number         Int
  edgeIndex      Int
  lengthM        Decimal?  @db.Decimal(10, 3)
  fieldUpdatedAt Json      @default("{}")
  updatedAt      DateTime
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  media          Media[]
  notes          Note[]

  @@index([roomId])
}

model Media {
  id             String            @id
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  inspectionId   String?
  inspection     Inspection?       @relation(fields: [inspectionId], references: [id])
  floorId        String?
  floor          Floor?            @relation(fields: [floorId], references: [id])
  roomId         String?
  room           Room?             @relation(fields: [roomId], references: [id])
  wallId         String?
  wall           Wall?             @relation(fields: [wallId], references: [id])
  answerId       String?
  answer         ChecklistAnswer?  @relation(fields: [answerId], references: [id])
  kind           MediaKind
  internal       Boolean           @default(true)
  storageKey     String?
  textContent    String?
  mimeType       String?
  fileName       String?
  fieldUpdatedAt Json              @default("{}")
  updatedAt      DateTime
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  @@index([projectId])
  @@index([dealId])
  @@index([updatedAt])
}

model Note {
  id             String            @id
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  inspectionId   String?
  inspection     Inspection?       @relation(fields: [inspectionId], references: [id])
  floorId        String?
  floor          Floor?            @relation(fields: [floorId], references: [id])
  roomId         String?
  room           Room?             @relation(fields: [roomId], references: [id])
  wallId         String?
  wall           Wall?             @relation(fields: [wallId], references: [id])
  answerId       String?
  answer         ChecklistAnswer?  @relation(fields: [answerId], references: [id])
  sectionKey     String?
  body           String
  internal       Boolean           @default(true)
  fieldUpdatedAt Json              @default("{}")
  updatedAt      DateTime
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  @@index([projectId])
  @@index([dealId])
  @@index([updatedAt])
}

model ChecklistTemplate {
  id       String                     @id @default(uuid())
  name     String
  versions ChecklistTemplateVersion[]
}

model ChecklistTemplateVersion {
  id          String             @id @default(uuid())
  templateId  String
  template    ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  sections    ChecklistSection[]
  inspections Inspection[]

  @@unique([templateId, version])
}

model ChecklistSection {
  id        String                   @id @default(uuid())
  versionId String
  version   ChecklistTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tradeCode String
  name      String
  sortOrder Int
  items     ChecklistItem[]

  @@index([versionId, sortOrder])
}

model ChecklistItem {
  id            String           @id @default(uuid())
  sectionId     String
  section       ChecklistSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prompt        String
  helpText      String?
  questionType  QuestionType
  required      Boolean          @default(false)
  choices       Json?
  sortOrder     Int
  unit          String?
  priceItemCode String?
  itemKey       String?
  config        Json?
  answers       ChecklistAnswer[]

  @@index([sectionId, sortOrder])
}

model ChecklistAnswer {
  id             String        @id
  inspectionId   String
  inspection     Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId         String
  item           ChecklistItem @relation(fields: [itemId], references: [id])
  value          Json?
  freeText       String?
  internalNote   String?
  fieldUpdatedAt Json          @default("{}")
  updatedAt      DateTime
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  media          Media[]
  notes          Note[]

  @@unique([inspectionId, itemId])
  @@index([updatedAt])
}

model Trade {
  id             String      @id
  code           String      @unique
  name           String
  sortOrder      Int
  /** Underleverandør prises med innkjøp/fastpris og telles ikke som egne timer. */
  subcontractor  Boolean     @default(false)
  items          PriceItem[]
  rates          TradeRate[]
}

model PriceList {
  id                String          @id @default(uuid())
  name              String
  validFrom         DateTime        @db.Date
  validTo           DateTime?       @db.Date
  status            PriceListStatus
  comment           String?
  createdFromId     String?
  adjustmentPercent Decimal?        @db.Decimal(6, 2)
  vatRate           Decimal         @default(0.25) @db.Decimal(6, 4)
  byggstartPercent  Decimal         @default(0.08) @db.Decimal(6, 4)
  byggstartFactor   Decimal         @default(1) @db.Decimal(6, 3)
  mittanbudPercent  Decimal         @default(0.05) @db.Decimal(6, 4)
  mittanbudFactor   Decimal         @default(1) @db.Decimal(6, 3)
  extraCalloutNok   Decimal?        @db.Decimal(10, 2)
  tileAllowanceExVat Decimal?       @db.Decimal(10, 2)
  electricianCostFactor Decimal     @default(1.15) @db.Decimal(6, 4)
  assemblyHourlyNok Decimal?        @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  rates             TradeRate[]
  lines             PriceLine[]
  quotes            Quote[]
  changes           PriceChangeLog[]
}

model TradeRate {
  id                    String    @id @default(uuid())
  priceListId           String
  priceList             PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  tradeId               String
  trade                 Trade     @relation(fields: [tradeId], references: [id])
  hourlyRateSale        Decimal   @db.Decimal(10, 2)
  hourlyRateInternal    Decimal   @db.Decimal(10, 2)
  calloutPrice          Decimal?  @db.Decimal(10, 2)
  defaultMaterialMarkup Decimal   @db.Decimal(6, 4)

  @@unique([priceListId, tradeId])
}

model PriceItem {
  id              String        @id
  code            String        @unique
  tradeId         String
  trade           Trade         @relation(fields: [tradeId], references: [id])
  name            String
  unit            String
  type            PriceItemType
  sortOrder       Int
  active          Boolean       @default(true)
  customerVisible Boolean       @default(true)
  internalNote    String?
  quantityFormula String?
  customerText    String?           @db.Text
  splitConfidence String            @default("known")
  splitNote       String?
  lines           PriceLine[]
  quoteLines      QuoteLine[]
  bomLines        BomLine[]
}

model PriceLine {
  id                 String    @id @default(uuid())
  priceListId        String
  priceList          PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceItemId        String
  priceItem          PriceItem @relation(fields: [priceItemId], references: [id])
  materialCost       Decimal   @default(0) @db.Decimal(12, 4)
  materialMarkup     Decimal?  @db.Decimal(6, 4)
  hoursPerUnit       Decimal   @default(0) @db.Decimal(10, 4)
  hourlyRateOverride Decimal?  @db.Decimal(10, 2)
  salePriceOverride  Decimal?  @db.Decimal(12, 2)
  costFormula        String?

  @@unique([priceListId, priceItemId])
}

model Quote {
  id                String      @id @default(uuid())
  projectId         String?
  project           Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dealId            String?
  deal              Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  familyId          String
  revision          String      @default("A")
  priceListId       String
  priceList         PriceList   @relation(fields: [priceListId], references: [id])
  inspectionId      String?
  status            QuoteStatus @default(draft)
  title             String      @default("Tilbud")
  channelCode       String      @default("none")
  extraProfitNok    Decimal     @default(0) @db.Decimal(12, 2)
  channelFeeFactor  Decimal?    @db.Decimal(6, 3)
  vatRate           Decimal     @default(0.25) @db.Decimal(6, 4)
  customerText      String?     @db.Text
  reservations      String?     @db.Text
  emailSubject      String?
  emailBody         String?     @db.Text
  validDays         Int         @default(30)
  sumExVat          Decimal     @default(0) @db.Decimal(12, 2)
  addonsExVat       Decimal     @default(0) @db.Decimal(12, 2)
  vatNok            Decimal     @default(0) @db.Decimal(12, 2)
  totalIncVat       Decimal     @default(0) @db.Decimal(12, 2)
  costExVat         Decimal     @default(0) @db.Decimal(12, 2)
  contributionExVat Decimal     @default(0) @db.Decimal(12, 2)
  marginExVat       Decimal     @default(0) @db.Decimal(8, 5)
  hoursTotal        Decimal     @default(0) @db.Decimal(10, 2)
  hoursByTrade      Json        @default("{}")
  flags             Json        @default("[]")
  /** Tilleggstekst fra utkastet. Standardtekst og forbehold ligger i customerText. */
  aiSuggestion      String?     @db.Text
  createdById       String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?       @relation("QuoteApprover", fields: [approvedById], references: [id])
  sentAt            DateTime?
  decidedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lines             QuoteLine[]
  events            QuoteEvent[]
  aiLogs            AiDraftLog[]

  @@index([projectId])
  @@index([dealId])
  @@index([familyId])
  @@index([status])
}

model QuoteLine {
  id              String     @id @default(uuid())
  quoteId         String
  quote           Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  priceItemId     String?
  priceItem       PriceItem? @relation(fields: [priceItemId], references: [id])
  tradeCode       String     @default("annet")
  code            String?
  description     String
  unit            String
  quantity        Decimal    @db.Decimal(12, 4)
  quantitySource  String
  unitPriceExVat  Decimal    @db.Decimal(12, 4)
  materialCost    Decimal    @default(0) @db.Decimal(12, 4)
  hours           Decimal    @default(0) @db.Decimal(10, 4)
  lineSumExVat    Decimal    @db.Decimal(12, 2)
  internal        Boolean    @default(false)
  optional        Boolean    @default(false)
  included        Boolean    @default(true)
  uncertain       Boolean    @default(false)
  uncertaintyNote String?
  rationale       String?
  sortOrder       Int
}

model QuoteEvent {
  id         String   @id @default(uuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  actorName  String
  note       String?
  createdAt  DateTime @default(now())

  @@index([quoteId, createdAt])
}

model ChangeOrderLine {
  id             String      @id @default(uuid())
  changeOrderId  String
  changeOrder    ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  priceItemId    String?
  tradeCode      String
  code           String?
  description    String
  unit           String
  quantity       Decimal     @db.Decimal(12, 4)
  unitPriceExVat Decimal     @db.Decimal(12, 4)
  hours          Decimal     @default(0) @db.Decimal(10, 4)
  lineSumExVat   Decimal     @db.Decimal(12, 2)
  rationale      String?
  uncertain      Boolean     @default(false)
  sortOrder      Int
}

model AiDraftLog {
  id           String   @id @default(uuid())
  quoteId      String?
  quote        Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changeOrderId String?
  provider     String
  model        String
  prompt       String   @db.Text
  response     String   @db.Text
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  createdAt    DateTime @default(now())
  actorId      String?

  @@index([quoteId])
}

model TextTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  kind      String
  tradeCode String?
  body      String   @db.Text
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TextBlockSet {
  id       String             @id @default(uuid())
  name     String
  versions TextBlockVersion[]
}

model TextBlockVersion {
  id          String       @id @default(uuid())
  setId       String
  set         TextBlockSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  version     Int
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  blocks      TextBlock[]

  @@unique([setId, version])
}

model TextBlock {
  id           String           @id @default(uuid())
  versionId    String
  version      TextBlockVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key          String
  name         String
  section      String
  kind         String
  body         String           @db.Text
  sortOrder    Int
  includeWhen  Json
  locked       Boolean          @default(true)
  aiSelectable Boolean          @default(false)

  @@unique([versionId, key])
  @@index([versionId, sortOrder])
}

model Supplier {
  id        String                @id @default(uuid())
  name      String
  code      String                @unique
  format    String                @default("csv")
  columnMap Json
  createdAt DateTime              @default(now())
  products  Product[]
  imports   SupplierPriceImport[]
}

model Product {
  id             String    @id @default(uuid())
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku            String
  nobb           String?
  ean            String?
  name           String
  unit           String    @default("stk")
  costPrice      Decimal?  @db.Decimal(12, 4)
  listPrice      Decimal?  @db.Decimal(12, 4)
  validFrom      DateTime? @db.Date
  discontinued   Boolean   @default(false)
  sourceImportId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bomLines       BomLine[]

  @@unique([supplierId, sku])
  @@index([nobb])
  @@index([ean])
}

model SupplierPriceImport {
  id          String                @id @default(uuid())
  supplierId  String
  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileName    String
  status      String
  summary     Json
  createdById String?
  createdAt   DateTime              @default(now())
  changes     SupplierPriceChange[]
}

model SupplierPriceChange {
  id         String              @id @default(uuid())
  importId   String
  import     SupplierPriceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  productId  String?
  sku        String
  name       String
  kind       String
  oldCost    Decimal?            @db.Decimal(12, 4)
  newCost    Decimal?            @db.Decimal(12, 4)
}

model BomLine {
  id         String     @id @default(uuid())
  priceItemId String
  priceItem  PriceItem  @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  kind       String
  sortOrder  Int
  label      String?
  amountNok  Decimal?   @db.Decimal(12, 4)
  productId  String?
  product    Product?   @relation(fields: [productId], references: [id])
  quantity   Decimal    @default(1) @db.Decimal(12, 4)

  @@index([priceItemId])
}

model PriceChangeLog {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceItemId String?
  actorId     String?
  actorName   String
  action      String
  detail      Json?
  createdAt   DateTime  @default(now())

  @@index([priceListId, createdAt])
}

model SyncConflict {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  field       String?
  clientValue Json?
  serverValue Json?
  winner      String
  reason      String
  userId      String?
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model MailLog {
  id        String   @id @default(uuid())
  toAddress String
  subject   String
  body      String
  meta      Json?
  provider  String
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model DealStageEvent {
  id            String   @id @default(uuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId   String?
  fromStageName String?
  toStageId     String?
  toStageName   String
  userId        String?
  userName      String
  at            DateTime @default(now())

  @@index([dealId, at])
  @@index([at])
}

model DealValueEvent {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromValue Decimal  @db.Decimal(12, 2)
  toValue   Decimal  @db.Decimal(12, 2)
  userId    String?
  userName  String
  at        DateTime @default(now())

  @@index([dealId, at])
}

model CustomField {
  id      String           @id
  key     String           @unique
  name    String
  kind    String
  options Json?
  values  DealFieldValue[]
}

model DealFieldValue {
  dealId  String
  deal    Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   String

  @@id([dealId, fieldId])
}

model SalesGoal {
  id          String   @id
  ownerId     String?
  owner       User?    @relation("GoalOwner", fields: [ownerId], references: [id])
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  metric      String
  target      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  @@index([ownerId, periodStart])
}

model SavedReport {
  id        String           @id @default(uuid())
  name      String
  ownerId   String
  owner     User             @relation("ReportOwner", fields: [ownerId], references: [id])
  shared    Boolean          @default(false)
  spec      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tiles     DashboardTile[]
}

model InsightDashboard {
  id        String          @id
  name      String
  slug      String          @unique
  ownerId   String
  owner     User            @relation("DashboardOwner", fields: [ownerId], references: [id])
  shared    Boolean         @default(true)
  createdAt DateTime        @default(now())
  tiles     DashboardTile[]
}

model DashboardTile {
  id          String           @id
  dashboardId String
  dashboard   InsightDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  reportId    String?
  report      SavedReport?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  title       String
  spec        Json
  view        String
  sortOrder   Int

  @@index([dashboardId, sortOrder])
}
